@echo off
chcp 65001 > nul
cd /d "%~dp0"

:: Проверка: был ли передан файл
if "%~1"=="" (
    echo [!] Ошибка: перетащите .gcode файл прямо на этот значок.
    echo.
    pause
    exit /b
)

:: Запуск Python-скрипта с переданным файлом
python print_spooler.py "%~1"

echo.
echo ==============================================
echo Печать завершена или прервана.
echo Нажмите любую клавишу для закрытия этого окна...
pause > nul